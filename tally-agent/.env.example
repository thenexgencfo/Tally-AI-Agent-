# ---- Database (synced Tally data; Tally remains system of record) ----
PG_DSN=postgresql://tally_ro:CHANGE_ME@127.0.0.1:5432/tally
PG_POOL_MIN=1
PG_POOL_MAX=8

# ---- Redis (cache + masking token vault; safe to flush) ----
REDIS_URL=redis://127.0.0.1:6379/0
TOKEN_TTL_SECONDS=3600
CACHE_TTL_SECONDS=120

# ---- Local LLM ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
LLM_TIMEOUT_SECONDS=45
LLM_ENABLED=true

# ---- Live Tally fallback (read-only MCP / XML). Leave blank to disable. ----
TALLY_LIVE_URL=
TALLY_LIVE_TIMEOUT=10

# ---- Service ----
BIND_HOST=127.0.0.1
BIND_PORT=8080
MAX_ROWS=20000
SYNC_STALE_WARN_MINUTES=10
