# Copy to deploy/.env and fill in. Generate each secret with a CSPRNG:
#   PowerShell: $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
#   Linux/WSL:  openssl rand -hex 24
# (Do not use Get-Random: it is not cryptographically secure.)
POSTGRES_SUPERUSER_PASSWORD=
RO_PASS=
OWNER_PASS=
REDIS_PASSWORD=
AUDIT_HASH_SALT=

# This machine's Tailscale IPv4 (run: tailscale ip -4)
CADDY_BIND_IP=
# The address staff type in the browser: set it to the SAME Tailscale IP as
# CADDY_BIND_IP. (Not the *.ts.net name: Caddy then tries to fetch the
# certificate from Tailscale, which it cannot reach inside Docker.)
AGENT_HOSTNAME=
# Caddy sees Docker's bridge address, not the tailnet address (see README step 5).
ALLOWED_CIDRS=100.64.0.0/10 fd7a:115c:a1e0::/48 127.0.0.1/8

OLLAMA_MODEL=qwen3:14b
LLM_ENABLED=true
LLM_NARRATE=true
SYNC_STALE_WARN_MINUTES=10
RATE_LIMIT_PER_MINUTE=30

# Only for a demo/test company whose books end in the past, e.g. 2025-03-31
REFERENCE_DATE=
# 1 loads fabricated demo data on FIRST start only. Never in production.
SEED_DEMO_DATA=0
